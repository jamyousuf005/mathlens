# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mathlens?retryWrites=true&w=majority

# Public Production / Deployment URL
NEXT_PUBLIC_APP_URL=https://mathlens-rho.vercel.app

# Resend API Configuration
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=MathLens <auth@yourdomain.com>

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Google Gemini API (OCR)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Optional Third-Party Fallback OCR (Groq Vision)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=qwen/qwen3.8-27b

# Global safety cap on paid OCR calls per 24h (default 2000)
OCR_DAILY_LIMIT=2000

# Only enable when Cloudflare is the outermost proxy in front of this app.
# On Vercel, leave unset: cf-connecting-ip is client-controlled there.
TRUST_CF_CONNECTING_IP=false

# Better Auth Configuration
BETTER_AUTH_SECRET=your-random-32-byte-secret-hex
BETTER_AUTH_URL=http://localhost:3000

